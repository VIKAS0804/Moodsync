# Copy to server/.env and fill in. Never commit the real file.

ENVIRONMENT=development
CORS_ORIGINS=*

# --- Database ---
DATABASE_URL=postgresql+psycopg://moodsync:moodsync@localhost:5432/moodsync

# --- Spotify ---
# https://developer.spotify.com/dashboard -> create app -> add the redirect URI below.
# The mobile app is a public client (PKCE), so the secret is optional and
# server-side only. Note: audio-features / recommendations are NOT available to
# apps created after 2024-11-27; this project doesn't use them.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=moodsync://callback

# --- Apple Music (catalog previews, developer token only) ---
# Apple Developer -> Certificates, Identifiers & Profiles -> Keys -> enable MusicKit.
# Download the .p8 once and keep it out of git.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# Alternative for container deploys (paste the PEM with \n escapes):
# APPLE_PRIVATE_KEY=
APPLE_STOREFRONT=us

# --- AWS (optional: S3 cache for preview clips) ---
AWS_REGION=us-east-1
S3_PREVIEW_BUCKET=
# S3_ENDPOINT_URL=http://localhost:4566   # LocalStack / MinIO

# --- Pipeline ---
PREVIEW_CACHE_DIR=.cache/previews
ANALYSIS_CONCURRENCY=4
# What to do when a track's ISRC isn't in Apple's catalog: fuzzy | exclude
UNMATCHED_TRACK_POLICY=fuzzy
